generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductType {
  MEDICINE
  NON_MEDICINE
}

enum StockInSourceType {
  MANUAL
  EXCEL
  CSV
  OCR
  WO_POS_MIGRATION
}

enum StockInStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InventoryBatchStatus {
  AVAILABLE
  DEPLETED
  EXPIRED
  DAMAGED
  CANCELLED
}

enum StockLedgerMovementType {
  STOCK_IN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  EXPIRED
  DAMAGED
  RETURN_TO_SUPPLIER
  CORRECTION
}

enum ImportJobStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  REVIEWED
  IMPORTED
  FAILED
  CANCELLED
}

enum ImportItemReviewStatus {
  PENDING
  MATCHED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  IMPORTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockIns         StockIn[]
  stockAdjustments StockAdjustment[]
  importJobs       ImportJob[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([name])
  @@map("categories")
}

model ProductClassification {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products                  Product[]
  classificationSuggestions ClassificationSuggestion[]

  @@index([name])
  @@index([isActive])
  @@map("product_classifications")
}

model GenericDrug {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("generic_drugs")
}

model DosageForm {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("dosage_forms")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("brands")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  categoryId           String?       @map("category_id") @db.Uuid
  classificationId     String?       @map("classification_id") @db.Uuid
  genericDrugId        String?       @map("generic_drug_id") @db.Uuid
  dosageFormId         String?       @map("dosage_form_id") @db.Uuid
  brandId              String?       @map("brand_id") @db.Uuid
  sku                  String?       @unique
  name                 String
  /// Legacy/free-text generic name used by existing data and imports. Prefer genericDrugId for normalized active ingredients.
  genericName          String?       @map("generic_name")
  brandName            String?       @map("brand_name")
  dosageForm           String?       @map("dosage_form")
  strength             String?
  unit                 String        @default("piece")
  productType          ProductType   @default(NON_MEDICINE) @map("product_type")
  defaultSellingPrice  Decimal?      @map("default_selling_price") @db.Decimal(12, 2)
  reorderLevel         Decimal       @default(0) @map("reorder_level") @db.Decimal(12, 3)
  requiresPrescription Boolean       @default(false) @map("requires_prescription")
  requiresExpiryTracking Boolean     @default(false) @map("requires_expiry_tracking")
  requiresLotTracking    Boolean     @default(false) @map("requires_lot_tracking")
  status               ProductStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  classification ProductClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  genericDrug GenericDrug? @relation(fields: [genericDrugId], references: [id], onDelete: SetNull)
  dosageFormRef DosageForm? @relation(fields: [dosageFormId], references: [id], onDelete: SetNull)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  aliases  ProductAlias[]
  barcodes ProductBarcode[]
  stockInItems         StockInItem[]
  inventoryBatches     InventoryBatch[]
  stockLedgerEntries   StockLedgerEntry[]
  stockAdjustmentItems StockAdjustmentItem[]
  selectedImportItems  ImportItem[]
  matchCandidates      MatchCandidate[]
  classificationSuggestions ClassificationSuggestion[]

  @@index([categoryId])
  @@index([classificationId])
  @@index([genericDrugId])
  @@index([dosageFormId])
  @@index([brandId])
  @@index([name])
  @@index([genericName])
  @@index([brandName])
  @@map("products")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  alias     String
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
  @@map("product_aliases")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stockIns StockIn[]

  @@unique([name])
  @@index([isActive])
  @@map("suppliers")
}

model StockIn {
  id               String            @id @default(uuid()) @db.Uuid
  supplierId       String?           @map("supplier_id") @db.Uuid
  receivedByUserId String            @map("received_by_user_id") @db.Uuid
  importJobId      String?           @map("import_job_id") @db.Uuid
  sourceType       StockInSourceType @map("source_type")
  invoiceNumber    String?           @map("invoice_number")
  receivedDate     DateTime          @map("received_date") @db.Date
  notes            String?
  status           StockInStatus     @default(DRAFT)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receivedByUser User          @relation(fields: [receivedByUserId], references: [id])
  importJob      ImportJob?    @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  items          StockInItem[]

  @@index([supplierId])
  @@index([receivedByUserId])
  @@unique([importJobId])
  @@index([receivedDate])
  @@index([sourceType, status])
  @@map("stock_ins")
}

model StockInItem {
  id             String    @id @default(uuid()) @db.Uuid
  stockInId      String    @map("stock_in_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  quantity       Decimal   @db.Decimal(12, 3)
  buyingPrice    Decimal   @map("buying_price") @db.Decimal(12, 2)
  sellingPrice   Decimal?  @map("selling_price") @db.Decimal(12, 2)
  expirationDate DateTime? @map("expiration_date") @db.Date
  lotNumber      String?   @map("lot_number")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  stockIn          StockIn          @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])
  inventoryBatches InventoryBatch[]

  @@index([stockInId])
  @@index([productId])
  @@index([expirationDate])
  @@map("stock_in_items")
}

model InventoryBatch {
  id                String               @id @default(uuid()) @db.Uuid
  productId         String               @map("product_id") @db.Uuid
  stockInItemId     String               @map("stock_in_item_id") @db.Uuid
  initialQuantity   Decimal              @map("initial_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal              @map("remaining_quantity") @db.Decimal(12, 3)
  buyingPrice       Decimal              @map("buying_price") @db.Decimal(12, 2)
  sellingPrice      Decimal?             @map("selling_price") @db.Decimal(12, 2)
  receivedDate      DateTime             @map("received_date") @db.Date
  expirationDate    DateTime?            @map("expiration_date") @db.Date
  lotNumber         String?              @map("lot_number")
  status            InventoryBatchStatus @default(AVAILABLE)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  product              Product               @relation(fields: [productId], references: [id])
  stockInItem          StockInItem           @relation(fields: [stockInItemId], references: [id])
  stockLedgerEntries   StockLedgerEntry[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@index([productId, status])
  @@index([stockInItemId])
  @@index([receivedDate])
  @@index([expirationDate])
  @@map("inventory_batches")
}

model StockLedgerEntry {
  id               String                  @id @default(uuid()) @db.Uuid
  productId        String                  @map("product_id") @db.Uuid
  inventoryBatchId String?                 @map("inventory_batch_id") @db.Uuid
  movementType     StockLedgerMovementType @map("movement_type")
  quantityChange   Decimal                 @map("quantity_change") @db.Decimal(12, 3)
  buyingPrice      Decimal?                @map("buying_price") @db.Decimal(12, 2)
  referenceType    String?                 @map("reference_type")
  referenceId      String?                 @map("reference_id") @db.Uuid
  occurredAt       DateTime                @default(now()) @map("occurred_at")
  notes            String?

  product        Product         @relation(fields: [productId], references: [id])
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@index([productId, occurredAt])
  @@index([inventoryBatchId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_ledger_entries")
}

model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  adjustedByUserId String   @map("adjusted_by_user_id") @db.Uuid
  reason           String
  notes            String?
  adjustedAt       DateTime @default(now()) @map("adjusted_at")
  createdAt        DateTime @default(now()) @map("created_at")

  adjustedByUser User                  @relation(fields: [adjustedByUserId], references: [id])
  items          StockAdjustmentItem[]

  @@index([adjustedByUserId])
  @@index([adjustedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String  @id @default(uuid()) @db.Uuid
  stockAdjustmentId String  @map("stock_adjustment_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  inventoryBatchId  String? @map("inventory_batch_id") @db.Uuid
  quantityChange    Decimal @map("quantity_change") @db.Decimal(12, 3)
  notes             String?

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  inventoryBatch  InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@index([stockAdjustmentId])
  @@index([productId])
  @@index([inventoryBatchId])
  @@map("stock_adjustment_items")
}

model ImportJob {
  id              String          @id @default(uuid()) @db.Uuid
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  sourceType      StockInSourceType @map("source_type")
  status          ImportJobStatus @default(UPLOADED)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdByUser User         @relation(fields: [createdByUserId], references: [id])
  stockIn       StockIn?
  files         ImportFile[]
  items         ImportItem[]

  @@index([createdByUserId])
  @@index([sourceType, status])
  @@map("import_jobs")
}

model ImportFile {
  id          String   @id @default(uuid()) @db.Uuid
  importJobId String   @map("import_job_id") @db.Uuid
  fileName    String   @map("file_name")
  mimeType    String?  @map("mime_type")
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_files")
}

model ImportItem {
  id                String                 @id @default(uuid()) @db.Uuid
  importJobId       String                 @map("import_job_id") @db.Uuid
  itemNumber        Int                    @map("item_number")
  rawProductName    String                 @map("raw_product_name")
  selectedProductId String?                @map("selected_product_id") @db.Uuid
  quantity          Decimal?               @db.Decimal(12, 3)
  buyingPrice       Decimal?               @map("buying_price") @db.Decimal(12, 2)
  sellingPrice      Decimal?               @map("selling_price") @db.Decimal(12, 2)
  expirationDate    DateTime?              @map("expiration_date") @db.Date
  lotNumber         String?                @map("lot_number")
  reviewStatus      ImportItemReviewStatus @default(PENDING) @map("review_status")
  rawData           Json?                  @map("raw_data")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  importJob                 ImportJob                  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  selectedProduct           Product?                   @relation(fields: [selectedProductId], references: [id], onDelete: SetNull)
  matchCandidates           MatchCandidate[]
  classificationSuggestions ClassificationSuggestion[]

  @@unique([importJobId, itemNumber])
  @@index([importJobId])
  @@index([selectedProductId])
  @@index([reviewStatus])
  @@map("import_items")
}

model MatchCandidate {
  id           String   @id @default(uuid()) @db.Uuid
  importItemId String   @map("import_item_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  score        Decimal  @db.Decimal(5, 4)
  method       String?
  createdAt    DateTime @default(now()) @map("created_at")

  importItem ImportItem @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([importItemId, productId])
  @@index([productId])
  @@index([score])
  @@map("match_candidates")
}

model ClassificationSuggestion {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  importItemId        String?  @map("import_item_id") @db.Uuid
  suggestedClassificationId String @map("suggested_classification_id") @db.Uuid
  confidence          Decimal  @db.Decimal(5, 4)
  modelName           String   @map("model_name")
  modelVersion        String?  @map("model_version")
  createdAt           DateTime @default(now()) @map("created_at")

  product                 Product?               @relation(fields: [productId], references: [id])
  importItem              ImportItem?            @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  suggestedClassification ProductClassification   @relation(fields: [suggestedClassificationId], references: [id])

  @@index([productId])
  @@index([importItemId])
  @@index([suggestedClassificationId])
  @@index([confidence])
  @@map("classification_suggestions")
}
