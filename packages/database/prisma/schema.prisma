generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductType {
  MEDICINE
  NON_MEDICINE
}

enum StockInSourceType {
  MANUAL
  EXCEL
  CSV
  OCR
  WO_POS_MIGRATION
}

enum StockInStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InventoryBatchStatus {
  AVAILABLE
  DEPLETED
  EXPIRED
  DAMAGED
  CANCELLED
}

enum StockLedgerMovementType {
  STOCK_IN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  EXPIRED
  DAMAGED
  RETURN_TO_SUPPLIER
  CORRECTION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockIns         StockIn[]
  stockAdjustments StockAdjustment[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([name])
  @@map("categories")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  categoryId           String?       @map("category_id") @db.Uuid
  sku                  String?       @unique
  name                 String
  genericName          String?       @map("generic_name")
  brandName            String?       @map("brand_name")
  dosageForm           String?       @map("dosage_form")
  strength             String?
  unit                 String        @default("piece")
  productType          ProductType   @default(NON_MEDICINE) @map("product_type")
  defaultSellingPrice  Decimal?      @map("default_selling_price") @db.Decimal(12, 2)
  reorderLevel         Decimal       @default(0) @map("reorder_level") @db.Decimal(12, 3)
  requiresPrescription Boolean       @default(false) @map("requires_prescription")
  requiresExpiryTracking Boolean     @default(false) @map("requires_expiry_tracking")
  requiresLotTracking    Boolean     @default(false) @map("requires_lot_tracking")
  status               ProductStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases  ProductAlias[]
  barcodes ProductBarcode[]
  stockInItems         StockInItem[]
  inventoryBatches     InventoryBatch[]
  stockLedgerEntries   StockLedgerEntry[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@index([categoryId])
  @@index([name])
  @@index([genericName])
  @@index([brandName])
  @@map("products")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  alias     String
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
  @@map("product_aliases")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stockIns StockIn[]

  @@unique([name])
  @@index([isActive])
  @@map("suppliers")
}

model StockIn {
  id               String            @id @default(uuid()) @db.Uuid
  supplierId       String?           @map("supplier_id") @db.Uuid
  receivedByUserId String            @map("received_by_user_id") @db.Uuid
  importJobId      String?           @map("import_job_id") @db.Uuid
  sourceType       StockInSourceType @map("source_type")
  invoiceNumber    String?           @map("invoice_number")
  receivedDate     DateTime          @map("received_date") @db.Date
  notes            String?
  status           StockInStatus     @default(DRAFT)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receivedByUser User          @relation(fields: [receivedByUserId], references: [id])
  items          StockInItem[]

  @@index([supplierId])
  @@index([receivedByUserId])
  @@index([importJobId])
  @@index([receivedDate])
  @@index([sourceType, status])
  @@map("stock_ins")
}

model StockInItem {
  id             String    @id @default(uuid()) @db.Uuid
  stockInId      String    @map("stock_in_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  quantity       Decimal   @db.Decimal(12, 3)
  buyingPrice    Decimal   @map("buying_price") @db.Decimal(12, 2)
  sellingPrice   Decimal?  @map("selling_price") @db.Decimal(12, 2)
  expirationDate DateTime? @map("expiration_date") @db.Date
  lotNumber      String?   @map("lot_number")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  stockIn          StockIn          @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])
  inventoryBatches InventoryBatch[]

  @@index([stockInId])
  @@index([productId])
  @@index([expirationDate])
  @@map("stock_in_items")
}

model InventoryBatch {
  id                String               @id @default(uuid()) @db.Uuid
  productId         String               @map("product_id") @db.Uuid
  stockInItemId     String               @map("stock_in_item_id") @db.Uuid
  initialQuantity   Decimal              @map("initial_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal              @map("remaining_quantity") @db.Decimal(12, 3)
  buyingPrice       Decimal              @map("buying_price") @db.Decimal(12, 2)
  sellingPrice      Decimal?             @map("selling_price") @db.Decimal(12, 2)
  receivedDate      DateTime             @map("received_date") @db.Date
  expirationDate    DateTime?            @map("expiration_date") @db.Date
  lotNumber         String?              @map("lot_number")
  status            InventoryBatchStatus @default(AVAILABLE)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  product              Product               @relation(fields: [productId], references: [id])
  stockInItem          StockInItem           @relation(fields: [stockInItemId], references: [id])
  stockLedgerEntries   StockLedgerEntry[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@index([productId, status])
  @@index([stockInItemId])
  @@index([receivedDate])
  @@index([expirationDate])
  @@map("inventory_batches")
}

model StockLedgerEntry {
  id               String                  @id @default(uuid()) @db.Uuid
  productId        String                  @map("product_id") @db.Uuid
  inventoryBatchId String?                 @map("inventory_batch_id") @db.Uuid
  movementType     StockLedgerMovementType @map("movement_type")
  quantityChange   Decimal                 @map("quantity_change") @db.Decimal(12, 3)
  buyingPrice      Decimal?                @map("buying_price") @db.Decimal(12, 2)
  referenceType    String?                 @map("reference_type")
  referenceId      String?                 @map("reference_id") @db.Uuid
  occurredAt       DateTime                @default(now()) @map("occurred_at")
  notes            String?

  product        Product         @relation(fields: [productId], references: [id])
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@index([productId, occurredAt])
  @@index([inventoryBatchId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_ledger_entries")
}

model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  adjustedByUserId String   @map("adjusted_by_user_id") @db.Uuid
  reason           String
  notes            String?
  adjustedAt       DateTime @default(now()) @map("adjusted_at")
  createdAt        DateTime @default(now()) @map("created_at")

  adjustedByUser User                  @relation(fields: [adjustedByUserId], references: [id])
  items          StockAdjustmentItem[]

  @@index([adjustedByUserId])
  @@index([adjustedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String  @id @default(uuid()) @db.Uuid
  stockAdjustmentId String  @map("stock_adjustment_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  inventoryBatchId  String? @map("inventory_batch_id") @db.Uuid
  quantityChange    Decimal @map("quantity_change") @db.Decimal(12, 3)
  notes             String?

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  inventoryBatch  InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@index([stockAdjustmentId])
  @@index([productId])
  @@index([inventoryBatchId])
  @@map("stock_adjustment_items")
}
