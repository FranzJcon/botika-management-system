generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductType {
  MEDICINE
  NON_MEDICINE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([name])
  @@map("categories")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  categoryId           String?       @map("category_id") @db.Uuid
  sku                  String?       @unique
  name                 String
  genericName          String?       @map("generic_name")
  brandName            String?       @map("brand_name")
  dosageForm           String?       @map("dosage_form")
  strength             String?
  unit                 String        @default("piece")
  productType          ProductType   @default(NON_MEDICINE) @map("product_type")
  defaultSellingPrice  Decimal?      @map("default_selling_price") @db.Decimal(12, 2)
  reorderLevel         Decimal       @default(0) @map("reorder_level") @db.Decimal(12, 3)
  requiresPrescription Boolean       @default(false) @map("requires_prescription")
  requiresExpiryTracking Boolean     @default(false) @map("requires_expiry_tracking")
  requiresLotTracking    Boolean     @default(false) @map("requires_lot_tracking")
  status               ProductStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases  ProductAlias[]
  barcodes ProductBarcode[]

  @@index([categoryId])
  @@index([name])
  @@index([genericName])
  @@index([brandName])
  @@map("products")
}

model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  alias     String
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
  @@map("product_aliases")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@index([isActive])
  @@map("suppliers")
}
